{
  "manifest_version": 3,
  "name": "东财DUFE数字党校党课不暂停播放",
  "version": "1.3.0",
  "description": "让课程视频在切换窗口时继续播放，并自动处理播放完成后的评价与提示弹窗；不加速、不跳进度、不改学习记录。",
  "minimum_chrome_version": "111",
  "permissions": ["scripting"],
  "host_permissions": ["*://szdx.dufe.edu.cn/*"],
  "content_scripts": [
    {
      "matches": ["*://szdx.dufe.edu.cn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://szdx.dufe.edu.cn/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "东财DUFE数字党校党课不暂停播放",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
